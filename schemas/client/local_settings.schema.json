{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/client/local_settings.schema.json",
  "title": "Solo Pages Local Settings v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "solo-settings-v3"
    },
    "starting_ticket_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "motion_preference": {
      "type": "string",
      "enum": [
        "SYSTEM",
        "REDUCED",
        "FULL"
      ]
    },
    "drag_enabled": {
      "type": "boolean"
    },
    "preferred_bench_view": {
      "type": "string",
      "enum": ["RELEVANT", "GLOBAL"]
    },
    "sfx_volume_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 40
    }
  },
  "required": [
    "schema_version",
    "starting_ticket_count",
    "motion_preference",
    "drag_enabled",
    "preferred_bench_view",
    "sfx_volume_percent"
  ]
}
