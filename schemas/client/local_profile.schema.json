{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/client/local_profile.schema.json",
  "title": "Solo Pages Local Profile v1",
  "description": "A local-only cosmetic identity. It contains no credential, account authority, or gameplay modifier.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "solo-profile-v1"
    },
    "profile_id": {
      "const": "profile.local"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "icon_id": {
      "type": "string",
      "enum": [
        "cosmetic.profile.console",
        "cosmetic.profile.field",
        "cosmetic.profile.storage",
        "cosmetic.profile.systems"
      ]
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "icon_id"
  ]
}
