{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/client/tutorial_catalog.schema.json",
  "title": "Solo tutorial catalog v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "actionType": {
      "enum": ["RUN_TEST", "PLAY_CARD", "REVISE_HYPOTHESIS", "COMMIT_ISOLATION", "PERFORM_REPAIR", "PERFORM_VERIFY", "DOCUMENT_LIVE", "PUBLISH_CLOSURE", "SEARCH", "REFRESH", "PASS_TURN"]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "checkpoint_kind": { "enum": ["EXPLAIN", "ACTION"] },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "target": { "enum": ["TICKET", "RESOURCES", "CANDIDATES", "BENCH", "EVIDENCE", "ISOLATION_GUIDANCE", "HAND", "DOCUMENTATION", "BASIC_ACTIONS", "RESULT"] },
        "action_type": { "$ref": "#/$defs/actionType" },
        "source_definition_id": { "$ref": "#/$defs/stableId" },
        "candidate_source": { "const": "LATEST_CONFIRM" },
        "expected_event_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
        "support_action_types": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/actionType" } }
      },
      "required": ["id", "checkpoint_kind", "title", "body", "target"],
      "allOf": [
        {
          "if": { "properties": { "checkpoint_kind": { "const": "ACTION" } } },
          "then": { "required": ["action_type", "expected_event_types", "support_action_types"] }
        },
        {
          "if": { "properties": { "checkpoint_kind": { "const": "EXPLAIN" } } },
          "then": { "not": { "anyOf": [{ "required": ["action_type"] }, { "required": ["expected_event_types"] }, { "required": ["support_action_types"] }] } }
        }
      ]
    }
  },
  "properties": {
    "tutorial_catalog_version": { "const": "tutorial-checkpoints-v1" },
    "ruleset_version": { "const": "first-version-v2" },
    "builder_version": { "const": "ticket-builder-v2" },
    "configuration_version": { "const": "ticket-builder-v2" },
    "ticket_content_version": { "const": "core-ticket-templates-diagnosis-v2" },
    "domain_content_version": { "const": "core-domain-snapshot-v1" },
    "card_catalog_version": { "const": "core-card-catalog-diagnosis-v2" },
    "tutorials": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "seed": { "type": "string", "minLength": 1 },
          "required_teaching_beat": { "$ref": "#/$defs/stableId" },
          "expected_ticket_definition_id": { "$ref": "#/$defs/stableId" },
          "checkpoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkpoint" } }
        },
        "required": ["id", "title", "summary", "seed", "required_teaching_beat", "expected_ticket_definition_id", "checkpoints"]
      }
    }
  },
  "required": ["tutorial_catalog_version", "ruleset_version", "builder_version", "configuration_version", "ticket_content_version", "domain_content_version", "card_catalog_version", "tutorials"]
}
