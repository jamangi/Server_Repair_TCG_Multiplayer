{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/fault_state.schema.json",
  "title": "Fault State",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "uuidLike": {
      "type": "string",
      "minLength": 8
    },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "cardInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "playerId": {
      "type": "string",
      "minLength": 1
    },
    "ticketInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "properties": {
    "fault_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "fault_id": {
      "$ref": "#/$defs/entityRef"
    },
    "ticket_instance_id": {
      "$ref": "#/$defs/ticketInstanceId"
    },
    "role": {
      "type": "string",
      "enum": [
        "ROOT",
        "INTERMEDIATE",
        "TERMINAL",
        "ACTIONABLE"
      ]
    },
    "actual_present": {
      "type": "boolean"
    },
    "machine_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "MITIGATED",
        "RESOLVED"
      ]
    },
    "reveal_state": {
      "type": "string",
      "enum": [
        "HIDDEN",
        "CATEGORY_ONLY",
        "REVEALED"
      ]
    },
    "resolved_by_action_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_at_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "upstream_fault_instance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "downstream_fault_instance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "fault_instance_id",
    "fault_id",
    "ticket_instance_id",
    "role",
    "actual_present",
    "machine_status",
    "reveal_state",
    "resolved_by_action_id",
    "resolved_at_revision",
    "upstream_fault_instance_ids",
    "downstream_fault_instance_ids"
  ]
}
