{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/match_state.schema.json",
  "title": "Authoritative Match State",
  "description": "Versioned server state. Public/private views are projections and must never receive this object directly.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "instanceId": { "type": "string", "minLength": 1 },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "properties": {
    "match_id": { "$ref": "#/$defs/instanceId" },
    "revision": { "type": "integer", "minimum": 0 },
    "ruleset_version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["SETUP", "ACTIVE", "COMPLETED", "ABORTED", "INVALIDATED"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collaboration_mode": { "type": "string", "enum": ["competitive", "cooperative"] },
        "termination_score": {
          "anyOf": [
            { "const": -1 },
            { "type": "integer", "minimum": 1, "maximum": 99 }
          ]
        },
        "starting_ticket_count": { "type": "integer", "minimum": 1, "maximum": 99 },
        "queue_minimum": { "type": "integer", "minimum": 0, "maximum": 99 },
        "seat_limit": { "type": "integer", "minimum": 1, "maximum": 99 },
        "turn_time_limit_seconds": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "match_time_limit_seconds_by_player": {
          "type": "object",
          "additionalProperties": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        },
        "starting_service_points_by_player": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": -99, "maximum": 99 }
        },
        "deck_size": { "const": 30 },
        "max_copies_per_card_id": { "enum": [3, 6] },
        "play_context": { "type": "string", "enum": ["SOLO", "TRAINING", "MULTIPLAYER"] },
        "opening_hand_size": { "const": 5 },
        "actions_per_turn": { "const": 2 },
        "starting_search_tokens": { "type": "integer", "minimum": 0 },
        "ticket_search_tokens": { "type": "integer", "minimum": 0 },
        "max_search_tokens": { "type": "integer", "minimum": 0 },
        "starting_refresh_tokens": { "type": "integer", "minimum": 0 },
        "max_refresh_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "collaboration_mode",
        "termination_score",
        "starting_ticket_count",
        "queue_minimum",
        "seat_limit",
        "turn_time_limit_seconds",
        "match_time_limit_seconds_by_player",
        "starting_service_points_by_player",
        "deck_size",
        "max_copies_per_card_id",
        "opening_hand_size",
        "actions_per_turn",
        "starting_search_tokens",
        "ticket_search_tokens",
        "max_search_tokens",
        "starting_refresh_tokens",
        "max_refresh_tokens"
      ]
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "player_state.schema.json" }
    },
    "match_seed": { "type": "string", "minLength": 1 },
    "starting_seat_number": { "type": "integer", "minimum": 1 },
    "turn_state": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "turn_state.schema.json" }
      ]
    },
    "active_tickets": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "ticket_state.schema.json" },
          {
            "properties": {
              "status": {
                "enum": [
                  "DIAGNOSIS",
                  "REPAIR_READY",
                  "AWAITING_VERIFY",
                  "RETURNED_TO_DIAGNOSIS",
                  "READY_TO_CLOSE"
                ]
              }
            }
          }
        ]
      }
    },
    "archived_ticket_instance_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/instanceId" },
      "uniqueItems": true
    },
    "card_instances": {
      "type": "array",
      "items": { "$ref": "card_instance.schema.json" }
    },
    "queued_ticket_definition_ids": {
      "description": "Pinned fixed-fixture or generated Ticket snapshot queue. Generated provenance/configuration is persisted by the future Ticket Builder domain contract.",
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" }
    },
    "contribution_ledger": {
      "description": "Frozen one-point Isolation/Repair slots attributable to their source actors and required actionable Fault instances.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contribution_id": { "$ref": "#/$defs/instanceId" },
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "source_event_id": { "$ref": "#/$defs/instanceId" },
          "contributor_player_id": { "$ref": "#/$defs/instanceId" },
          "fault_instance_id": { "$ref": "#/$defs/instanceId" },
          "contribution_class": { "type": "string", "enum": ["ISOLATION", "REPAIR"] },
          "slot_key": { "$ref": "#/$defs/instanceId" },
          "point_value": { "const": 1 },
          "settlement_status": {
            "type": "string",
            "enum": ["PENDING", "SETTLED", "SUPERSEDED", "INELIGIBLE", "VOID_GIVE_UP"]
          }
        },
        "required": [
          "contribution_id",
          "ticket_instance_id",
          "source_event_id",
          "contributor_player_id",
          "fault_instance_id",
          "contribution_class",
          "slot_key",
          "point_value",
          "settlement_status"
        ]
      }
    },
    "service_point_events": {
      "description": "Public one-point score records emitted at closure for eligible Isolation/Repair slots.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "score_event_id": { "$ref": "#/$defs/instanceId" },
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "source_contribution_id": { "$ref": "#/$defs/instanceId" },
          "contributor_player_id": { "$ref": "#/$defs/instanceId" },
          "contribution_class": { "type": "string", "enum": ["ISOLATION", "REPAIR"] },
          "recipient_player_id": { "type": ["string", "null"], "minLength": 1 },
          "recipient_team_id": { "type": ["string", "null"], "minLength": 1 },
          "delta": { "const": 1 },
          "settled_by_closure_event_id": { "$ref": "#/$defs/instanceId" }
        },
        "required": [
          "score_event_id",
          "ticket_instance_id",
          "source_contribution_id",
          "contributor_player_id",
          "contribution_class",
          "recipient_player_id",
          "recipient_team_id",
          "delta",
          "settled_by_closure_event_id"
        ],
        "oneOf": [
          {
            "properties": {
              "recipient_player_id": { "type": "string", "minLength": 1 },
              "recipient_team_id": { "const": null }
            }
          },
          {
            "properties": {
              "recipient_player_id": { "const": null },
              "recipient_team_id": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "closure_statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "closure_event_id": { "$ref": "#/$defs/instanceId" },
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "closer_player_id": { "$ref": "#/$defs/instanceId" },
          "attributed_team_id": { "type": ["string", "null"], "minLength": 1 },
          "closed_at": { "$ref": "#/$defs/timestamp" }
        },
        "required": [
          "closure_event_id",
          "ticket_instance_id",
          "closer_player_id",
          "attributed_team_id",
          "closed_at"
        ]
      }
    },
    "give_up_statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "give_up_event_id": { "$ref": "#/$defs/instanceId" },
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "player_id": { "$ref": "#/$defs/instanceId" },
          "abandoned_at": { "$ref": "#/$defs/timestamp" }
        },
        "required": ["give_up_event_id", "ticket_instance_id", "player_id", "abandoned_at"]
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "game_event.schema.json" }
    },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "last_queue_reconciliation_event_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "winner_player_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true
        },
        "winning_team_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true
        },
        "valid": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ADMIN_INVALIDATION",
              "NO_HUMANS",
              "FORFEIT",
              "QUEUE_EMPTY",
              "SCORE_THRESHOLD",
              "STALEMATE",
              "SIMULATION_CAP"
              ,"GIVE_UP"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "final_player_scores": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": -99, "maximum": 9999 }
        },
        "final_team_scores": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": -99, "maximum": 9999 }
        },
        "statistics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "enum": [
                  "TICKET_CLOSURE",
                  "SETTLED_CAUSAL_AWARD",
                  "TEST",
                  "ISOLATION",
                  "REPAIR",
                  "VERIFY",
                  "DOCUMENTATION",
                  "ASSIST",
                  "REJECTED_ISOLATION",
                  "FAILED_VERIFY",
                  "REDUNDANT_ACTION",
                  "TURN",
                  "AUTHORITATIVE_SECONDS",
                  "DISCONNECT",
                  "CONCESSION"
                  ,"ELIMINATION"
                  ,"GIVE_UP"
                ]
              },
              "value": { "type": "integer", "minimum": 0 },
              "player_id": { "type": ["string", "null"], "minLength": 1 },
              "team_id": { "type": ["string", "null"], "minLength": 1 },
              "ticket_instance_id": { "type": ["string", "null"], "minLength": 1 }
            },
            "required": ["metric", "value", "player_id", "team_id", "ticket_instance_id"]
          }
        },
        "evaluated_after_event_id": { "$ref": "#/$defs/instanceId" },
        "completed_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "winner_player_ids",
        "winning_team_ids",
        "valid",
        "reason_codes",
        "final_player_scores",
        "final_team_scores",
        "statistics",
        "evaluated_after_event_id",
        "completed_at"
      ]
    }
  },
  "required": [
    "match_id",
    "revision",
    "ruleset_version",
    "status",
    "created_at",
    "updated_at",
    "configuration",
    "players",
    "match_seed",
    "starting_seat_number",
    "turn_state",
    "active_tickets",
    "archived_ticket_instance_ids",
    "card_instances",
    "queued_ticket_definition_ids",
    "contribution_ledger",
    "service_point_events",
    "closure_statistics",
    "events",
    "event_sequence",
    "last_queue_reconciliation_event_id",
    "result"
  ]
}
