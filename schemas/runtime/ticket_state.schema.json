{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/ticket_state.schema.json",
  "title": "Authoritative Ticket State",
  "description": "Ticket-owned lifecycle, machine changes, evidence-supported Isolation, preserved Verify history, incremental publication, and immutable closure record.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "instanceId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "isolationRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation_event_id": { "$ref": "#/$defs/instanceId" },
        "isolation_route_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "player_id": { "$ref": "#/$defs/instanceId" },
        "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
        "cited_evidence_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "accepted": { "type": "boolean" },
        "classification": {
          "type": ["string", "null"],
          "enum": [null, "ACTIONABLE", "DEEPEST", "ACTIONABLE_AND_DEEPEST"]
        },
        "public_fault_instance_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "response_code": {
          "type": "string",
          "enum": ["ISOLATION_ACCEPTED", "ISOLATION_NOT_SUPPORTED"]
        },
        "committed_at_revision": { "type": "integer", "minimum": 0 },
        "committed_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "isolation_event_id",
        "player_id",
        "candidate_fault_id",
        "cited_evidence_event_ids",
        "accepted",
        "classification",
        "public_fault_instance_id",
        "response_code",
        "committed_at_revision",
        "committed_at"
      ],
      "allOf": [
        {
          "if": { "properties": { "accepted": { "const": true } } },
          "then": {
            "properties": {
              "classification": {
                "type": "string",
                "enum": ["ACTIONABLE", "DEEPEST", "ACTIONABLE_AND_DEEPEST"]
              },
              "public_fault_instance_id": { "type": "string", "minLength": 1 },
              "response_code": { "const": "ISOLATION_ACCEPTED" }
            }
          }
        },
        {
          "if": { "properties": { "accepted": { "const": false } } },
          "then": {
            "properties": {
              "classification": { "const": null },
              "public_fault_instance_id": { "const": null },
              "response_code": { "const": "ISOLATION_NOT_SUPPORTED" }
            }
          }
        }
      ]
    },
    "repairRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repair_event_id": { "$ref": "#/$defs/instanceId" },
        "player_id": { "$ref": "#/$defs/instanceId" },
        "isolation_event_id": { "$ref": "#/$defs/instanceId" },
        "card_instance_id": { "$ref": "#/$defs/instanceId" },
        "repair_procedure_id": { "$ref": "#/$defs/entityRef" },
        "target_fault_instance_id": { "$ref": "#/$defs/instanceId" },
        "machine_state_before": { "type": "string", "minLength": 1 },
        "machine_state_after": { "type": "string", "minLength": 1 },
        "machine_revision": { "type": "integer", "minimum": 1 },
        "repaired_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "repair_event_id",
        "player_id",
        "isolation_event_id",
        "card_instance_id",
        "repair_procedure_id",
        "target_fault_instance_id",
        "machine_state_before",
        "machine_state_after",
        "machine_revision",
        "repaired_at"
      ]
    },
    "verifyRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify_event_id": { "$ref": "#/$defs/instanceId" },
        "player_id": { "$ref": "#/$defs/instanceId" },
        "validation_procedure_id": { "$ref": "#/$defs/entityRef" },
        "requirement_id": { "$ref": "#/$defs/entityRef" },
        "result": { "type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
        "machine_revision": { "type": "integer", "minimum": 0 },
        "diagnosis_revision": { "type": "integer", "minimum": 0 },
        "is_current": { "type": "boolean" },
        "verified_at_revision": { "type": "integer", "minimum": 0 },
        "verified_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "verify_event_id",
        "player_id",
        "validation_procedure_id",
        "requirement_id",
        "result",
        "machine_revision",
        "is_current",
        "verified_at_revision",
        "verified_at"
      ]
    },
    "solutionReveal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fault_id": { "$ref": "#/$defs/entityRef" },
              "role": { "type": "string", "enum": ["ROOT", "INTERMEDIATE", "TERMINAL", "ACTIONABLE"] },
              "actionable": { "type": "boolean" },
              "deepest": { "type": "boolean" }
            },
            "required": ["fault_id", "role", "actionable", "deepest"]
          }
        },
        "causal_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cause_fault_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
              "effect_fault_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
            },
            "required": ["cause_fault_id", "effect_fault_id"]
          }
        },
        "evidence_solution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
              "route_kind": { "type": "string", "enum": ["DIRECT_OBSERVATION", "DEFINITIVE_DIAGNOSTIC", "CORROBORATED_SUPPORT", "EVIDENCE_BACKED_ELIMINATION", "RECOVERY_DERIVED"] },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_definition_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
                    "summary": { "type": "string", "minLength": 1 }
                  },
                  "required": ["source_definition_id", "summary"]
                }
              },
              "eliminated_candidate_fault_ids": { "type": "array", "items": { "$ref": "#/$defs/entityRef" }, "uniqueItems": true }
            },
            "required": ["candidate_fault_id", "route_kind", "evidence", "eliminated_candidate_fault_ids"]
          }
        },
        "repair_solution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "repair_procedure_id": { "$ref": "#/$defs/entityRef" }, "summary": { "type": "string", "minLength": 1 } },
            "required": ["repair_procedure_id", "summary"]
          }
        },
        "verification_solution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "validation_procedure_id": { "$ref": "#/$defs/entityRef" }, "summary": { "type": "string", "minLength": 1 } },
            "required": ["validation_procedure_id", "summary"]
          }
        }
      },
      "required": ["faults", "causal_links", "evidence_solution", "repair_solution", "verification_solution"]
    },
    "closureRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closure_event_id": { "$ref": "#/$defs/instanceId" },
        "closer_player_id": { "$ref": "#/$defs/instanceId" },
        "attributed_team_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "action_cost": { "const": 0 },
        "accepted_isolation_event_id": { "$ref": "#/$defs/instanceId" },
        "decisive_evidence_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "repair_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "failed_verify_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true
        },
        "current_passing_verify_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "worklog_locked_event_id": { "$ref": "#/$defs/instanceId" },
        "score_event_ids": {
          "description": "Public score events emitted for eligible frozen Isolation/Repair slots; this may be empty when no slot remains eligible.",
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true
        },
        "ticket_archived_event_id": { "$ref": "#/$defs/instanceId" },
        "utility_grant_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true
        },
        "queue_reconciled_event_id": { "$ref": "#/$defs/instanceId" },
        "terminal_evaluated_event_id": { "$ref": "#/$defs/instanceId" },
        "turn_ended_event_id": { "$ref": "#/$defs/instanceId" },
        "closed_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "closure_event_id",
        "closer_player_id",
        "attributed_team_id",
        "action_cost",
        "accepted_isolation_event_id",
        "decisive_evidence_event_ids",
        "repair_event_ids",
        "failed_verify_event_ids",
        "current_passing_verify_event_ids",
        "worklog_locked_event_id",
        "score_event_ids",
        "ticket_archived_event_id",
        "utility_grant_event_ids",
        "queue_reconciled_event_id",
        "terminal_evaluated_event_id",
        "turn_ended_event_id",
        "closed_at"
      ]
    }
  },
  "properties": {
    "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
    "ticket_definition_id": { "$ref": "#/$defs/entityRef" },
    "status": {
      "type": "string",
      "enum": [
        "DIAGNOSIS",
        "REPAIR_READY",
        "AWAITING_VERIFY",
        "RETURNED_TO_DIAGNOSIS",
        "READY_TO_CLOSE",
        "CLOSED",
        "ABANDONED"
      ]
    },
    "machine_revision": { "type": "integer", "minimum": 0 },
    "diagnosis_revision": { "type": "integer", "minimum": 0 },
    "visible_symptom_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "uniqueItems": true
    },
    "public_candidate_fault_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "uniqueItems": true,
      "minItems": 1
    },
    "fault_states": {
      "description": "Authoritative server-only machine/Fault state; never copy this field into public/private player views.",
      "type": "array",
      "items": { "$ref": "fault_state.schema.json" }
    },
    "isolation_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/isolationRecord" }
    },
    "elimination_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "elimination_event_id": { "$ref": "#/$defs/instanceId" },
          "player_id": { "$ref": "#/$defs/instanceId" },
          "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
          "eliminated": { "type": "boolean" },
          "cited_evidence_event_ids": { "type": "array", "items": { "$ref": "#/$defs/instanceId" }, "uniqueItems": true },
          "diagnosis_revision": { "type": "integer", "minimum": 0 },
          "visibility": { "type": "string", "enum": ["PRIVATE_PLAYER", "TEAM"] },
          "visible_to_player_ids": { "type": "array", "items": { "$ref": "#/$defs/instanceId" }, "uniqueItems": true },
          "visible_to_team_ids": { "type": "array", "items": { "$ref": "#/$defs/instanceId" }, "uniqueItems": true },
          "supersedes_elimination_event_id": { "type": ["string", "null"], "minLength": 1 },
          "recorded_at": { "$ref": "#/$defs/timestamp" }
        },
        "required": ["elimination_event_id", "player_id", "candidate_fault_id", "eliminated", "cited_evidence_event_ids", "diagnosis_revision", "visibility", "visible_to_player_ids", "visible_to_team_ids", "supersedes_elimination_event_id", "recorded_at"]
      }
    },
    "current_accepted_isolation_event_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "repair_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/repairRecord" }
    },
    "verification_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/verifyRecord" }
    },
    "current_verify_pass_event_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/instanceId" },
      "uniqueItems": true
    },
    "return_to_diagnosis_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "return_event_id": { "$ref": "#/$defs/instanceId" },
          "failed_verify_event_id": { "$ref": "#/$defs/instanceId" },
          "invalidated_pass_event_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/instanceId" },
            "uniqueItems": true
          },
          "returned_at_revision": { "type": "integer", "minimum": 0 },
          "returned_at": { "$ref": "#/$defs/timestamp" }
        },
        "required": [
          "return_event_id",
          "failed_verify_event_id",
          "invalidated_pass_event_ids",
          "returned_at_revision",
          "returned_at"
        ]
      }
    },
    "documentation_publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "publication_event_id": { "$ref": "#/$defs/instanceId" },
          "source_action_event_id": { "$ref": "#/$defs/instanceId" },
          "source_result_event_id": { "$ref": "#/$defs/instanceId" },
          "worklog_placeholder_event_id": { "$ref": "#/$defs/instanceId" },
          "publisher_player_id": { "$ref": "#/$defs/instanceId" },
          "published_at": { "$ref": "#/$defs/timestamp" }
        },
        "required": [
          "publication_event_id",
          "source_action_event_id",
          "source_result_event_id",
          "worklog_placeholder_event_id",
          "publisher_player_id",
          "published_at"
        ]
      }
    },
    "worklog_event_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/instanceId" },
      "uniqueItems": true
    },
    "pending_contributions": {
      "description": "Frozen one-point Isolation/Repair slots. Eligibility remains server-only until closure; settled awards are public.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contribution_id": { "$ref": "#/$defs/instanceId" },
          "source_event_id": { "$ref": "#/$defs/instanceId" },
          "contributor_player_id": { "$ref": "#/$defs/instanceId" },
          "fault_instance_id": { "$ref": "#/$defs/instanceId" },
          "contribution_class": { "type": "string", "enum": ["ISOLATION", "REPAIR"] },
          "slot_key": { "$ref": "#/$defs/instanceId" },
          "point_value": { "const": 1 },
          "settlement_status": {
            "type": "string",
            "enum": ["PENDING", "SETTLED", "SUPERSEDED", "INELIGIBLE", "VOID_GIVE_UP"]
          },
          "score_event_id": {
            "type": ["string", "null"],
            "minLength": 1
          }
        },
        "required": [
          "contribution_id",
          "source_event_id",
          "contributor_player_id",
          "fault_instance_id",
          "contribution_class",
          "slot_key",
          "point_value",
          "settlement_status",
          "score_event_id"
        ]
      }
    },
    "closure": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/closureRecord" }
      ]
    },
    "abandonment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "give_up_event_id": { "$ref": "#/$defs/instanceId" },
        "reveal_event_id": { "$ref": "#/$defs/instanceId" },
        "player_id": { "$ref": "#/$defs/instanceId" },
        "solution_reveal": { "$ref": "#/$defs/solutionReveal" },
        "abandoned_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["give_up_event_id", "reveal_event_id", "player_id", "solution_reveal", "abandoned_at"]
    },
    "archived": { "type": "boolean" }
  },
  "required": [
    "ticket_instance_id",
    "ticket_definition_id",
    "status",
    "machine_revision",
    "visible_symptom_ids",
    "public_candidate_fault_ids",
    "fault_states",
    "isolation_history",
    "current_accepted_isolation_event_id",
    "repair_history",
    "verification_history",
    "current_verify_pass_event_ids",
    "return_to_diagnosis_history",
    "documentation_publications",
    "worklog_event_ids",
    "pending_contributions",
    "closure",
    "archived"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["DIAGNOSIS", "RETURNED_TO_DIAGNOSIS"] }
        }
      },
      "then": {
        "properties": {
          "current_accepted_isolation_event_id": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["REPAIR_READY", "AWAITING_VERIFY", "READY_TO_CLOSE", "CLOSED"] }
        }
      },
      "then": {
        "properties": {
          "current_accepted_isolation_event_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "AWAITING_VERIFY" } } },
      "then": {
        "properties": {
          "repair_history": { "minItems": 1 },
          "closure": { "const": null },
          "archived": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "DIAGNOSIS",
              "REPAIR_READY",
              "AWAITING_VERIFY",
              "RETURNED_TO_DIAGNOSIS",
              "READY_TO_CLOSE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "closure": { "const": null },
          "archived": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "RETURNED_TO_DIAGNOSIS" } } },
      "then": {
        "properties": {
          "current_accepted_isolation_event_id": { "const": null },
          "return_to_diagnosis_history": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "READY_TO_CLOSE" } } },
      "then": {
        "properties": {
          "current_verify_pass_event_ids": { "minItems": 1 },
          "closure": { "const": null },
          "archived": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "CLOSED" } } },
      "then": {
        "properties": {
          "current_verify_pass_event_ids": { "minItems": 1 },
          "closure": { "$ref": "#/$defs/closureRecord" },
          "archived": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ABANDONED" } } },
      "then": {
        "properties": {
          "closure": { "const": null },
          "abandonment": { "type": "object" },
          "archived": { "const": true }
        },
        "required": ["abandonment"]
      }
    }
  ]
}
