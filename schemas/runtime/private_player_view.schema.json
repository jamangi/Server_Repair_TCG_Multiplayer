{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/private_player_view.schema.json",
  "title": "Private Player Match View",
  "description": "Authenticated Player projection installed as a revisioned snapshot before any explicitly supplied unseen semantic events.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "instanceId": { "type": "string", "minLength": 1 },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    }
  },
  "properties": {
    "projection_version": { "type": "string", "enum": ["engine-projection-v1", "engine-projection-v2"] },
    "player_id": { "$ref": "#/$defs/instanceId" },
    "match_id": { "$ref": "#/$defs/instanceId" },
    "team_id": { "type": ["string", "null"], "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "public_match": { "$ref": "public_match_view.schema.json" },
    "hand": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "card_instance_id": { "$ref": "#/$defs/instanceId" },
          "card_definition_id": { "$ref": "#/$defs/entityRef" }
        },
        "required": ["card_instance_id", "card_definition_id"]
      }
    },
    "diagnostic_bench": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "card_instance_id": { "$ref": "#/$defs/instanceId" },
          "card_definition_id": { "$ref": "#/$defs/entityRef" },
          "diagnostic_type": { "type": "string", "enum": ["TEST", "COMMAND"] },
          "action_cost": { "type": "integer", "minimum": 0, "maximum": 2 },
          "category": { "type": "string", "minLength": 1 },
          "ticket_relevance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
                "relevant": { "type": "boolean" },
                "why_relevant_paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "entity_ids": { "type": "array", "items": { "$ref": "#/$defs/entityRef" }, "minItems": 1 },
                      "relationship_roles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                    },
                    "required": ["entity_ids", "relationship_roles"]
                  }
                }
              },
              "required": ["ticket_instance_id", "relevant", "why_relevant_paths"]
            }
          }
        },
        "required": ["card_instance_id", "card_definition_id", "diagnostic_type", "action_cost", "category", "ticket_relevance"]
      }
    },
    "deck_count": { "type": "integer", "minimum": 0 },
    "discard_card_instance_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/instanceId" },
      "uniqueItems": true
    },
    "search_card_definition_ids": { "type": "array", "items": { "$ref": "#/$defs/entityRef" }, "uniqueItems": true },
    "utility_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search_tokens": { "type": "integer", "minimum": 0 },
        "max_search_tokens": { "type": "integer", "minimum": 0 },
        "refresh_tokens": { "type": "integer", "minimum": 0 },
        "max_refresh_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "search_tokens",
        "max_search_tokens",
        "refresh_tokens",
        "max_refresh_tokens"
      ]
    },
    "knowledge_states": {
      "type": "array",
      "items": { "$ref": "knowledge_state.schema.json" }
    },
    "hypotheses": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/entityRef" }, "uniqueItems": true, "maxItems": 2 }
    },
    "documentable_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "source_action_event_id": { "$ref": "#/$defs/instanceId" },
          "source_result_event_id": { "$ref": "#/$defs/instanceId" },
          "worklog_placeholder_event_id": { "$ref": "#/$defs/instanceId" },
          "source_card_instance_id": { "$ref": "#/$defs/instanceId" },
          "source_card_owner_player_id": { "$ref": "#/$defs/instanceId" },
          "recovery_available": { "type": "boolean" }
        },
        "required": ["ticket_instance_id", "source_action_event_id", "source_result_event_id", "worklog_placeholder_event_id", "source_card_instance_id", "source_card_owner_player_id", "recovery_available"]
      }
    },
    "closure_bundles": { "type": "object", "additionalProperties": { "type": "object" } },
    "eliminations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "elimination_event_id": { "$ref": "#/$defs/instanceId" },
          "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
          "eliminated": { "type": "boolean" },
          "diagnosis_revision": { "type": "integer", "minimum": 0 },
          "cited_evidence_event_ids": { "type": "array", "items": { "$ref": "#/$defs/instanceId" }, "uniqueItems": true }
        },
        "required": ["ticket_instance_id", "elimination_event_id", "candidate_fault_id", "eliminated", "diagnosis_revision", "cited_evidence_event_ids"]
      }
    },
    "solution_reveals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket_instance_id": { "$ref": "#/$defs/instanceId" },
          "abandoned_at": { "type": "string", "format": "date-time" },
          "solution_reveal": { "$ref": "ticket_state.schema.json#/$defs/solutionReveal" }
        },
        "required": ["ticket_instance_id", "abandoned_at", "solution_reveal"]
      }
    },
    "diagnostic_relevance_notice": { "type": "string", "minLength": 1 },
    "authorized_events": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "game_event.schema.json" },
          {
            "properties": {
              "visibility": {
                "enum": ["PRIVATE_PLAYER", "TEAM", "PUBLIC_MATCH"]
              }
            }
          }
        ]
      }
    },
    "legal_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "ticket_instance_id": { "type": ["string", "null"], "minLength": 1 },
          "card_instance_id": { "type": ["string", "null"], "minLength": 1 }
        },
        "required": ["action_type", "ticket_instance_id", "card_instance_id"]
      }
    },
    "legal_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "payload": { "type": "object" }
        },
        "required": ["action_type", "payload"]
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_installed": { "const": true },
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "snapshot_event_sequence": { "type": "integer", "minimum": 0 },
        "unseen_semantic_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceId" },
          "uniqueItems": true
        }
      },
      "required": [
        "snapshot_installed",
        "snapshot_revision",
        "snapshot_event_sequence",
        "unseen_semantic_event_ids"
      ]
    }
  },
  "required": [
    "player_id",
    "match_id",
    "team_id",
    "revision",
    "public_match",
    "hand",
    "deck_count",
    "discard_card_instance_ids",
    "utility_resources",
    "authorized_events",
    "reconnect"
  ]
}
