{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/action_result.schema.json",
  "title": "Server Action Result",
  "description": "Player-safe result of one revision-bound intent. Event arrays must already be projected for their named audience.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "match_revision_before": { "type": "integer", "minimum": 0 },
    "match_revision_after": { "type": "integer", "minimum": 0 },
    "payment_applied": { "type": "boolean" },
    "actions_spent": { "type": "integer", "minimum": 0, "maximum": 2 },
    "utility_resources_spent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search_tokens": { "type": "integer", "minimum": 0, "maximum": 1 },
        "refresh_tokens": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "required": ["search_tokens", "refresh_tokens"]
    },
    "public_events": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "game_event.schema.json" },
          { "properties": { "visibility": { "const": "PUBLIC_MATCH" } } }
        ]
      }
    },
    "team_events": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "game_event.schema.json" },
          { "properties": { "visibility": { "const": "TEAM" } } }
        ]
      }
    },
    "private_events": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "game_event.schema.json" },
          { "properties": { "visibility": { "const": "PRIVATE_PLAYER" } } }
        ]
      }
    },
    "error_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "ILLEGAL_REQUEST",
        "MATCH_MISMATCH",
        "ACTOR_MISMATCH",
        "IDEMPOTENCY_CONFLICT",
        "STALE_REVISION",
        "REPAIR_GATE_NOT_SATISFIED",
        "IDENTICAL_TEST_NO_NEW_OUTCOME",
        "INVALID_CLOSURE_BUNDLE",
        "INSUFFICIENT_ACTIONS",
        "INSUFFICIENT_UTILITY_RESOURCE",
        "ILLEGAL_TARGET",
        "NOT_ACTIVE_PLAYER",
        "ILLEGAL_CARD",
        "CONTENT_INVALID",
        "NO_AUTHORED_OUTCOME",
        "STALE_MACHINE_REVISION",
        "ZERO_ACTION_NAME_LIMIT",
        "NO_CHANGE",
        "ILLEGAL_TIMING",
        "VERIFY_NOT_READY",
        "ILLEGAL_DOCUMENT_SOURCE",
        "UNSUPPORTED_ACTION_TYPE"
        ,"ELIMINATION_NOT_SUPPORTED"
        ,"GIVE_UP_NOT_ALLOWED"
        ,"CONFIRMATION_REQUIRED"
      ]
    },
    "error_message": { "type": ["string", "null"] },
    "rejected_at": {
      "type": ["string", "null"],
      "enum": [null, "BEFORE_PAYMENT"]
    },
    "recovered_card_instance_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "opened_resolution_window": {
      "type": "string",
      "enum": ["NONE", "CLOSURE"]
    },
    "resolution_code": {
      "type": ["string", "null"],
      "enum": [null, "RESOLVED", "ISOLATION_NOT_SUPPORTED"]
    },
    "target_summary": { "type": ["string", "null"] },
    "result_summary": { "type": ["string", "null"] }
  },
  "required": [
    "request_id",
    "accepted",
    "match_revision_before",
    "match_revision_after",
    "payment_applied",
    "actions_spent",
    "utility_resources_spent",
    "public_events",
    "team_events",
    "private_events",
    "error_code",
    "error_message",
    "rejected_at",
    "recovered_card_instance_id",
    "opened_resolution_window",
    "resolution_code",
    "target_summary",
    "result_summary"
  ],
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": true } } },
      "then": {
        "properties": {
          "payment_applied": { "const": true },
          "error_code": { "const": null },
          "error_message": { "const": null },
          "rejected_at": { "const": null }
          ,"target_summary": { "type": "string", "minLength": 1 }
          ,"result_summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "accepted": { "const": false } } },
      "then": {
        "properties": {
          "payment_applied": { "const": false },
          "actions_spent": { "const": 0 },
          "utility_resources_spent": {
            "properties": {
              "search_tokens": { "const": 0 },
              "refresh_tokens": { "const": 0 }
            }
          },
          "public_events": { "maxItems": 0 },
          "team_events": { "maxItems": 0 },
          "private_events": { "maxItems": 0 },
          "rejected_at": { "const": "BEFORE_PAYMENT" }
          ,"target_summary": { "const": null }
          ,"result_summary": { "const": null }
        }
      }
    },
    {
      "if": { "properties": { "error_code": { "const": "STALE_REVISION" } } },
      "then": {
        "properties": {
          "accepted": { "const": false },
          "match_revision_after": { "type": "integer", "minimum": 0 }
        }
      }
    }
  ]
}
