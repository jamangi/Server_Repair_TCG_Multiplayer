{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/story/common.schema.json",
  "title": "Story common definitions v1",
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "natural": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "transition": {
      "enum": ["CUT", "FADE", "DISSOLVE", "SLIDE"]
    },
    "position": {
      "enum": ["LEFT", "CENTER", "RIGHT", "FULL"]
    },
    "style_key": {
      "enum": ["DIALOGUE", "NARRATION", "SYSTEM", "THOUGHT"]
    }
  }
}
