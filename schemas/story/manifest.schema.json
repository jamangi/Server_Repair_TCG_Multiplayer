{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/story/manifest.schema.json",
  "title": "Declarative Story pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pack_version": { "const": "story-pack-v1" },
    "pack_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "content_version": { "$ref": "common.schema.json#/$defs/stable_id" },
    "default_locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "entry_label": { "$ref": "common.schema.json#/$defs/stable_id" },
    "library_entry_labels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/stable_id" }
    },
    "max_call_depth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "max_settle_steps": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$" }
    },
    "text_catalogs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$" }
    },
    "registry": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$" }
  },
  "required": [
    "pack_version", "pack_id", "content_version", "default_locale", "entry_label",
    "library_entry_labels", "max_call_depth", "max_settle_steps", "scripts", "text_catalogs", "registry"
  ]
}
