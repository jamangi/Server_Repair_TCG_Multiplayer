{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/story/match_result.schema.json",
  "title": "Normalized Story Match result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "story-match-result-v1" },
    "result_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "match_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "match_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "completion": { "enum": ["COMPLETED", "ABANDONED", "INVALID"] },
    "valid": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
    },
    "story_service_points_gained": { "$ref": "common.schema.json#/$defs/natural" },
    "tickets_closed": { "$ref": "common.schema.json#/$defs/natural" },
    "tickets_given_up": { "$ref": "common.schema.json#/$defs/natural" },
    "documented_outcome": { "type": "boolean" },
    "verified_outcome": { "type": "boolean" },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_run": { "$ref": "common.schema.json#/$defs/natural" },
        "isolations_accepted": { "$ref": "common.schema.json#/$defs/natural" },
        "repairs_performed": { "$ref": "common.schema.json#/$defs/natural" },
        "verify_passes": { "$ref": "common.schema.json#/$defs/natural" },
        "documentation_actions": { "$ref": "common.schema.json#/$defs/natural" }
      },
      "required": ["tests_run", "isolations_accepted", "repairs_performed", "verify_passes", "documentation_actions"]
    }
  },
  "required": [
    "schema_version", "result_id", "match_id", "match_ref", "completion", "valid", "reason_codes",
    "story_service_points_gained", "tickets_closed", "tickets_given_up", "documented_outcome",
    "verified_outcome", "contributions"
  ]
}
