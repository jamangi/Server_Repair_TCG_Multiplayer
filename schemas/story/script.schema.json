{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/story/script.schema.json",
  "title": "Declarative Story script v1",
  "$defs": {
    "story_value": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "string" },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "op": { "enum": ["ALL", "ANY"] },
            "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          },
          "required": ["op", "conditions"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": { "op": { "const": "NOT" }, "condition": { "$ref": "#/$defs/condition" } },
          "required": ["op", "condition"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "op": { "const": "VARIABLE_EQUALS" },
            "variable_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "value": { "$ref": "#/$defs/story_value" }
          },
          "required": ["op", "variable_id", "value"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "op": { "const": "CHOICE_IS" },
            "choice_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "option_id": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["op", "choice_id", "option_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "op": { "const": "STORY_POINTS_AT_LEAST" },
            "value": { "$ref": "common.schema.json#/$defs/natural" }
          },
          "required": ["op", "value"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "op": { "const": "MATCH_RESULT" },
            "match_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
            "field": {
              "enum": [
                "completion", "valid", "story_service_points_gained", "tickets_closed", "tickets_given_up",
                "documented_outcome", "verified_outcome"
              ]
            },
            "comparator": { "enum": ["EQUALS", "AT_LEAST"] },
            "value": {
              "anyOf": [
                { "type": "boolean" },
                { "type": "string" },
                { "$ref": "common.schema.json#/$defs/natural" }
              ]
            }
          },
          "required": ["op", "match_ref", "field", "comparator", "value"]
        }
      ]
    },
    "statement": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": { "type": { "const": "label" }, "label_id": { "$ref": "common.schema.json#/$defs/stable_id" } },
          "required": ["type", "label_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "scene" },
            "scene_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "background_asset_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "location_text_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "time_text_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "transition": { "$ref": "common.schema.json#/$defs/transition" },
            "checkpoint_id": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["type", "scene_id", "background_asset_id", "location_text_id", "time_text_id", "transition"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "show" }, "tag": { "$ref": "common.schema.json#/$defs/stable_id" },
            "layer": { "const": "characters" }, "character_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "pose_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "position": { "$ref": "common.schema.json#/$defs/position" },
            "transition": { "$ref": "common.schema.json#/$defs/transition" }
          },
          "required": ["type", "tag", "layer", "character_id", "pose_id", "position", "transition"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "show" }, "tag": { "$ref": "common.schema.json#/$defs/stable_id" },
            "layer": { "const": "transient" }, "asset_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "position": { "$ref": "common.schema.json#/$defs/position" },
            "transition": { "$ref": "common.schema.json#/$defs/transition" }
          },
          "required": ["type", "tag", "layer", "asset_id", "position", "transition"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "hide" }, "tag": { "$ref": "common.schema.json#/$defs/stable_id" },
            "layer": { "enum": ["characters", "transient"] },
            "transition": { "$ref": "common.schema.json#/$defs/transition" }
          },
          "required": ["type", "tag", "layer", "transition"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "say" }, "statement_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "speaker_key": { "$ref": "common.schema.json#/$defs/stable_id" },
            "text_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "style_key": { "$ref": "common.schema.json#/$defs/style_key" }
          },
          "required": ["type", "statement_id", "speaker_key", "text_id", "style_key"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "narrate" }, "statement_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "text_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "style_key": { "$ref": "common.schema.json#/$defs/style_key" }
          },
          "required": ["type", "statement_id", "text_id", "style_key"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "choice" }, "choice_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "prompt_text_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "options": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "option_id": { "$ref": "common.schema.json#/$defs/stable_id" },
                  "text_id": { "$ref": "common.schema.json#/$defs/stable_id" },
                  "jump_label": { "$ref": "common.schema.json#/$defs/stable_id" },
                  "writes": {
                    "type": "array",
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "properties": {
                        "variable_id": { "$ref": "common.schema.json#/$defs/stable_id" },
                        "value": { "$ref": "#/$defs/story_value" }
                      },
                      "required": ["variable_id", "value"]
                    }
                  }
                },
                "required": ["option_id", "text_id", "jump_label", "writes"]
              }
            }
          },
          "required": ["type", "choice_id", "prompt_text_id", "options"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "set" }, "variable_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "value": { "$ref": "#/$defs/story_value" }
          },
          "required": ["type", "variable_id", "value"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "if" }, "condition": { "$ref": "#/$defs/condition" },
            "then_label": { "$ref": "common.schema.json#/$defs/stable_id" },
            "else_label": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["type", "condition", "then_label", "else_label"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "jump" }, "label_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "loop_id": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["type", "label_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": { "type": { "const": "call" }, "label_id": { "$ref": "common.schema.json#/$defs/stable_id" } },
          "required": ["type", "label_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": { "type": { "const": "return" } },
          "required": ["type"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "checkpoint" }, "checkpoint_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "resume_label": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["type", "checkpoint_id", "resume_label"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "start_match" }, "match_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
            "return_label": { "$ref": "common.schema.json#/$defs/stable_id" },
            "pre_match_checkpoint_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "post_match_checkpoint_id": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["type", "match_ref", "return_label", "pre_match_checkpoint_id", "post_match_checkpoint_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "end" }, "ending_id": { "$ref": "common.schema.json#/$defs/stable_id" },
            "checkpoint_id": { "$ref": "common.schema.json#/$defs/stable_id" }
          },
          "required": ["type", "ending_id", "checkpoint_id"]
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "script_version": { "const": "story-script-v1" },
    "script_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "chapter_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "statements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/statement" } }
  },
  "required": ["script_version", "script_id", "chapter_id", "statements"]
}
