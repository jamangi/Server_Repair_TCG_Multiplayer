{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/repair_ticket.schema.json",
  "title": "Repair Ticket Definition",
  "description": "Complete authored Ticket content shared by fixed fixtures and validated Ticket Builder snapshots. Server-only truth and unexecuted outcomes must never enter player-safe projections.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "entityRef": {
      "$ref": "#/$defs/stableId"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "short_description": { "type": "string" },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset_id": { "type": "string", "minLength": 1 },
            "alt_text": { "type": "string" },
            "caption": { "type": "string" },
            "crop_hint": { "type": "string" },
            "license_note": { "type": "string" }
          },
          "required": ["asset_id", "alt_text"]
        }
      },
      "required": ["display_name"]
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expansion_id": { "$ref": "#/$defs/entityRef" },
        "version": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "published", "deprecated"]
        },
        "search_tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "required": ["expansion_id", "version", "status"]
    },
    "candidateEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
        "disposition": {
          "type": "string",
          "enum": ["SUPPORT", "CONTRADICT", "RULE_OUT", "CONFIRM", "INCONCLUSIVE"]
        }
      },
      "required": ["candidate_fault_id", "disposition"]
    },
    "isolationRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route_id": { "$ref": "#/$defs/stableId" },
        "route_kind": {
          "type": "string",
          "enum": ["DIRECT_OBSERVATION", "DEFINITIVE_DIAGNOSTIC", "CORROBORATED_SUPPORT", "EVIDENCE_BACKED_ELIMINATION", "RECOVERY_DERIVED"]
        },
        "target_fault_instance_key": { "$ref": "#/$defs/stableId" },
        "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
        "classification": { "type": "string", "enum": ["ACTIONABLE", "DEEPEST", "ACTIONABLE_AND_DEEPEST"] },
        "eligible_outcome_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true, "minItems": 1 },
        "eligible_verification_outcome_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true, "minItems": 1 },
        "supporting_outcome_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true, "minItems": 1 },
        "required_eliminated_candidate_fault_ids": { "type": "array", "items": { "$ref": "#/$defs/entityRef" }, "uniqueItems": true, "minItems": 1 },
        "minimum_distinct_outcomes": { "type": "integer", "minimum": 2 }
      },
      "required": ["route_id", "route_kind", "target_fault_instance_key", "candidate_fault_id", "classification"]
    },
    "generationProvenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "generator_version": { "$ref": "#/$defs/entityRef" },
        "content_version": { "$ref": "#/$defs/entityRef" },
        "domain_content_version": { "$ref": "#/$defs/entityRef" },
        "card_catalog_version": { "$ref": "#/$defs/entityRef" },
        "configuration_version": { "$ref": "#/$defs/entityRef" },
        "configuration_id": { "$ref": "#/$defs/entityRef" },
        "attempt_id": { "$ref": "#/$defs/entityRef" },
        "seed": { "type": "string", "minLength": 1 },
        "generation_index": { "type": "integer", "minimum": 0 },
        "template_id": { "$ref": "#/$defs/entityRef" },
        "fallback_attempt_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "part_ids": {
          "description": "Every immutable authored part selected for an assembled Ticket.",
          "type": "array",
          "items": { "$ref": "#/$defs/entityRef" },
          "uniqueItems": true,
          "minItems": 1
        },
        "fingerprint_id": {
          "description": "Stable release-facing identifier for the supported authored path.",
          "$ref": "#/$defs/entityRef"
        },
        "causal_fingerprint": {
          "description": "Canonical SHA-256 digest of the assembled causal graph.",
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "generator_version",
        "content_version",
        "domain_content_version",
        "card_catalog_version",
        "configuration_version",
        "configuration_id",
        "attempt_id",
        "seed",
        "generation_index",
        "template_id",
        "fallback_attempt_id"
      ]
    }
  },
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "entity_type": { "const": "repair_ticket" },
    "ruleset_version": { "const": "first-version-v2" },
    "ticket_contract_version": { "const": "repair-ticket-v2" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "source": { "$ref": "#/$defs/sourceMeta" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
    "server_profile_id": { "$ref": "#/$defs/entityRef" },
    "initial_symptom_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "uniqueItems": true,
      "minItems": 1
    },
    "public_context_entity_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "uniqueItems": true
    },
    "public_candidate_fault_ids": {
      "description": "Authored candidate set visible to every Player; it does not reveal which candidate is true.",
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "uniqueItems": true,
      "minItems": 1
    },
    "server_only_truth": {
      "description": "Authoritative causal and machine-state blueprint. This object is never included in a player-safe projection.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_machine_state_key": { "$ref": "#/$defs/stableId" },
        "fault_instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fault_instance_key": { "$ref": "#/$defs/stableId" },
              "fault_id": { "$ref": "#/$defs/entityRef" },
              "role": {
                "type": "string",
                "enum": ["ROOT", "INTERMEDIATE", "TERMINAL", "ACTIONABLE"]
              },
              "actionable": { "type": "boolean" },
              "deepest": { "type": "boolean" },
              "required_to_repair": { "type": "boolean" }
            },
            "required": [
              "fault_instance_key",
              "fault_id",
              "role",
              "actionable",
              "deepest",
              "required_to_repair"
            ]
          }
        },
        "causal_edge_ids": {
          "description": "Stable authored edge references retained for cross-reference compatibility.",
          "type": "array",
          "items": { "$ref": "#/$defs/entityRef" },
          "uniqueItems": true
        },
        "causal_edges": {
          "description": "Instance-bound uses of authored causal edges. Multiple Fault instances may use the same authored edge.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "causal_edge_id": { "$ref": "#/$defs/entityRef" },
              "cause_fault_instance_key": { "$ref": "#/$defs/stableId" },
              "effect_fault_instance_key": { "$ref": "#/$defs/stableId" }
            },
            "required": ["causal_edge_id", "cause_fault_instance_key", "effect_fault_instance_key"]
          },
          "uniqueItems": true
        }
      },
      "required": ["initial_machine_state_key", "fault_instances", "causal_edge_ids", "causal_edges"]
    },
    "authored_evidence_outcomes": {
      "description": "Server-selected authored Evidence for eligible Test, Command, inspection, or system executions.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome_id": { "$ref": "#/$defs/stableId" },
          "source_definition_id": { "$ref": "#/$defs/entityRef" },
          "target_ref": { "$ref": "#/$defs/stableId" },
          "eligible_machine_state_key": { "$ref": "#/$defs/stableId" },
          "candidate_effects": {
            "type": "array",
            "items": { "$ref": "#/$defs/candidateEffect" }
          },
          "outcome_classification": { "type": "string", "enum": ["CANDIDATE_EFFECT", "CLEAN", "IRRELEVANT", "INCONCLUSIVE"] },
          "observation_id": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "public_summary": { "type": "string", "minLength": 1 }
        },
        "required": [
          "outcome_id",
          "source_definition_id",
          "target_ref",
          "eligible_machine_state_key",
          "candidate_effects",
          "observation_id",
          "public_summary"
        ]
      }
    },
    "isolation_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "$ref": "#/$defs/stableId" },
          "target_fault_instance_key": { "$ref": "#/$defs/stableId" },
          "candidate_fault_id": { "$ref": "#/$defs/entityRef" },
          "classification": {
            "type": "string",
            "enum": ["ACTIONABLE", "DEEPEST", "ACTIONABLE_AND_DEEPEST"]
          },
          "minimum_citations": { "type": "integer", "minimum": 1 },
          "eligible_outcome_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/stableId" },
            "uniqueItems": true
          },
          "eligible_verification_outcome_ids": {
            "description": "Completed authored Verify outcomes that may be cited as decisive Evidence for this Isolation. This keeps failed Verify as a typed Diagnosis input rather than inventing a second Evidence record.",
            "type": "array",
            "items": { "$ref": "#/$defs/stableId" },
            "uniqueItems": true
          },
          "routes": {
            "type": "array",
            "items": { "$ref": "#/$defs/isolationRoute" },
            "minItems": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "requirement_id",
              "target_fault_instance_key",
              "candidate_fault_id",
              "classification",
              "minimum_citations",
              "eligible_outcome_ids",
              "eligible_verification_outcome_ids"
            ],
            "anyOf": [
              { "properties": { "eligible_outcome_ids": { "minItems": 1 } } },
              { "properties": { "eligible_verification_outcome_ids": { "minItems": 1 } } }
            ]
          },
          {
            "required": ["requirement_id", "target_fault_instance_key", "candidate_fault_id", "classification", "routes"]
          }
        ]
      }
    },
    "repair_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "$ref": "#/$defs/stableId" },
          "target_fault_instance_key": { "$ref": "#/$defs/stableId" },
          "fault_id": { "$ref": "#/$defs/entityRef" },
          "eligible_repair_procedure_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/entityRef" },
            "uniqueItems": true,
            "minItems": 1
          },
          "eligible_repair_outcome_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/stableId" },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "requirement_id",
          "target_fault_instance_key",
          "fault_id",
          "eligible_repair_procedure_ids",
          "eligible_repair_outcome_ids"
        ]
      }
    },
    "authored_repair_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome_id": { "$ref": "#/$defs/stableId" },
          "repair_procedure_id": { "$ref": "#/$defs/entityRef" },
          "target_fault_instance_key": { "$ref": "#/$defs/stableId" },
          "eligible_machine_state_key": { "$ref": "#/$defs/stableId" },
          "resulting_machine_state_key": { "$ref": "#/$defs/stableId" },
          "resolved_fault_instance_keys": {
            "type": "array",
            "items": { "$ref": "#/$defs/stableId" },
            "uniqueItems": true
          },
          "necessary_for_closure": { "type": "boolean" },
          "public_summary": { "type": "string", "minLength": 1 }
        },
        "required": [
          "outcome_id",
          "repair_procedure_id",
          "target_fault_instance_key",
          "eligible_machine_state_key",
          "resulting_machine_state_key",
          "resolved_fault_instance_keys",
          "necessary_for_closure",
          "public_summary"
        ]
      }
    },
    "verification_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "$ref": "#/$defs/stableId" },
          "validation_procedure_id": { "$ref": "#/$defs/entityRef" },
          "success_condition": { "type": "string", "minLength": 1 },
          "must_pass_after_latest_repair": { "const": true }
        },
        "required": [
          "requirement_id",
          "validation_procedure_id",
          "success_condition",
          "must_pass_after_latest_repair"
        ]
      }
    },
    "authored_verification_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome_id": { "$ref": "#/$defs/stableId" },
          "validation_procedure_id": { "$ref": "#/$defs/entityRef" },
          "requirement_id": { "$ref": "#/$defs/stableId" },
          "eligible_machine_state_key": { "$ref": "#/$defs/stableId" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
          "resulting_machine_state_key": { "$ref": "#/$defs/stableId" },
          "revealed_candidate_fault_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/entityRef" },
            "uniqueItems": true
          },
          "candidate_effects": {
            "type": "array",
            "items": { "$ref": "#/$defs/candidateEffect" }
          },
          "public_summary": { "type": "string", "minLength": 1 }
        },
        "required": [
          "outcome_id",
          "validation_procedure_id",
          "requirement_id",
          "eligible_machine_state_key",
          "result",
          "resulting_machine_state_key",
          "revealed_candidate_fault_ids",
          "candidate_effects",
          "public_summary"
        ]
      }
    },
    "closure_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_accepted_isolation": { "const": true },
        "include_cited_decisive_evidence": { "const": true },
        "include_every_repair_in_accepted_path": { "const": true },
        "include_every_failed_verify_in_accepted_path": { "const": true },
        "include_all_current_passing_verifies": { "const": true },
        "required_fault_instance_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "required_isolation_requirement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "required_repair_outcome_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true,
          "minItems": 1
        },
        "required_verification_requirement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "include_accepted_isolation",
        "include_cited_decisive_evidence",
        "include_every_repair_in_accepted_path",
        "include_every_failed_verify_in_accepted_path",
        "include_all_current_passing_verifies",
        "required_fault_instance_keys",
        "required_isolation_requirement_ids",
        "required_repair_outcome_ids",
        "required_verification_requirement_ids"
      ]
    },
    "generation_provenance": { "$ref": "#/$defs/generationProvenance" },
    "educational_objectives": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "id",
    "entity_type",
    "presentation",
    "source",
    "difficulty",
    "initial_symptom_ids",
    "public_candidate_fault_ids",
    "server_only_truth",
    "authored_evidence_outcomes",
    "isolation_requirements",
    "repair_requirements",
    "authored_repair_outcomes",
    "verification_requirements",
    "authored_verification_outcomes",
    "closure_requirements",
    "generation_provenance"
  ]
}
