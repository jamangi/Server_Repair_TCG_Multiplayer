{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/repair_ticket.schema.json",
  "title": "Repair Ticket Definition",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string"
        },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "alt_text": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "crop_hint": {
              "type": "string"
            },
            "license_note": {
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "alt_text"
          ]
        }
      },
      "required": [
        "display_name"
      ]
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expansion_id": {
          "$ref": "#/$defs/entityRef"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "published",
            "deprecated"
          ]
        },
        "search_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "expansion_id",
        "status"
      ]
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "entity_type": {
      "const": "repair_ticket"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "source": {
      "$ref": "#/$defs/sourceMeta"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "service_points": {
      "type": "integer",
      "minimum": 1
    },
    "server_profile_id": {
      "$ref": "#/$defs/entityRef"
    },
    "initial_symptom_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "fault_blueprint": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fault_id": {
            "$ref": "#/$defs/entityRef"
          },
          "role": {
            "type": "string",
            "enum": [
              "root",
              "intermediate",
              "terminal",
              "actionable"
            ]
          },
          "initial_visibility": {
            "type": "string",
            "enum": [
              "hidden",
              "category_only",
              "visible"
            ]
          },
          "required_to_identify": {
            "type": "boolean"
          },
          "required_to_repair": {
            "type": "boolean"
          }
        },
        "required": [
          "fault_id",
          "role",
          "initial_visibility",
          "required_to_identify",
          "required_to_repair"
        ]
      }
    },
    "verification_requirement_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "documentation_requirement_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "educational_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "entity_type",
    "presentation",
    "source",
    "difficulty",
    "service_points",
    "initial_symptom_ids",
    "fault_blueprint",
    "verification_requirement_ids"
  ]
}
