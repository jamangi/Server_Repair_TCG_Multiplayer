{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/test.schema.json",
  "title": "Test",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string"
        },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "alt_text": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "crop_hint": {
              "type": "string"
            },
            "license_note": {
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "alt_text"
          ]
        }
      },
      "required": [
        "display_name"
      ]
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expansion_id": {
          "$ref": "#/$defs/entityRef"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "published",
            "deprecated"
          ]
        },
        "search_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "expansion_id",
        "status"
      ]
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "entity_type": {
      "const": "test"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "source": {
      "$ref": "#/$defs/sourceMeta"
    },
    "test_type": {
      "type": "string",
      "minLength": 1
    },
    "tool_requirement_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "command_requirement_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "target_component_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "evidence_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fault_id": {
            "$ref": "#/$defs/entityRef"
          },
          "possible_outcomes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "supports",
                "contradicts",
                "confirms",
                "rules_out",
                "inconclusive"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "fault_id",
          "possible_outcomes"
        ]
      }
    },
    "diagnostic_strength": {
      "type": "integer",
      "minimum": 0
    },
    "action_cost": {
      "type": "integer",
      "minimum": 0
    },
    "education_text": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "entity_type",
    "presentation",
    "source",
    "test_type",
    "evidence_rules",
    "diagnostic_strength",
    "action_cost"
  ]
}
