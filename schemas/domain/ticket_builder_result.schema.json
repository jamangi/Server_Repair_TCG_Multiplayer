{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ticket_builder_result.schema.json",
  "title": "Ticket Builder Result",
  "description": "Server-only auditable Builder attempts. Failed attempts contain no partial Ticket snapshots; an explicit fallback remains a separate attempt.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_CONFIGURATION",
            "VERSION_MISMATCH",
            "INVALID_AUTHORED_INPUT",
            "REFERENCE_NOT_FOUND",
            "CAUSAL_GRAPH_INVALID",
            "CARD_POOL_UNREACHABLE",
            "NO_ELIGIBLE_TEMPLATE",
            "BATCH_GUARANTEE_UNSATISFIABLE",
            "PROGRESSIVE_BAND_UNSATISFIABLE",
            "DUPLICATE_FINGERPRINT_UNSATISFIABLE",
            "REQUESTED_COUNT_UNSATISFIABLE",
            "FALLBACK_CONFIGURATION_NOT_FOUND"
          ]
        },
        "constraint": {
          "type": "string",
          "enum": [
            "CONFIGURATION",
            "VERSION",
            "AUTHORED_INPUT",
            "REFERENCE",
            "CAUSAL_DAG",
            "CARD_POOL",
            "ALLOWED_EXCLUDED",
            "CATEGORY_GUARANTEE",
            "TEACHING_BEAT_GUARANTEE",
            "DIFFICULTY",
            "FAULT_COUNT",
            "ACTIONABLE_FAULT_COUNT",
            "CAUSAL_DEPTH",
            "INBOUND_BRANCHING",
            "OUTBOUND_BRANCHING",
            "PROGRESSIVE_DIFFICULTY",
            "DUPLICATE_FINGERPRINT",
            "REQUESTED_COUNT",
            "FALLBACK"
          ]
        },
        "detail": { "type": "string", "minLength": 1 },
        "template_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "requested_count": { "type": ["integer", "null"], "minimum": 0 },
        "eligible_count": { "type": ["integer", "null"], "minimum": 0 },
        "generated_index": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": [
        "code",
        "constraint",
        "detail",
        "template_ids",
        "requested_count",
        "eligible_count",
        "generated_index"
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "SUCCESS" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "diagnostics": { "maxItems": 0 },
              "selected_template_ids": { "minItems": 1 },
              "ticket_snapshot_digests": { "minItems": 1 },
              "ticket_snapshots": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "diagnostics": { "minItems": 1 },
              "selected_template_ids": { "maxItems": 0 },
              "ticket_snapshot_digests": { "maxItems": 0 },
              "ticket_snapshots": { "maxItems": 0 }
            }
          }
        }
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/stableId" },
        "attempt_kind": { "type": "string", "enum": ["PRIMARY", "FALLBACK"] },
        "parent_attempt_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "configuration": {
          "$ref": "https://example.local/schemas/ticket_builder_configuration.schema.json"
        },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILURE"] },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "selected_template_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        },
        "ticket_snapshot_digests": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "ticket_snapshots": {
          "type": "array",
          "items": { "$ref": "https://example.local/schemas/repair_ticket.schema.json" }
        }
      },
      "required": [
        "attempt_id",
        "attempt_kind",
        "parent_attempt_id",
        "configuration",
        "status",
        "diagnostics",
        "selected_template_ids",
        "ticket_snapshot_digests",
        "ticket_snapshots"
      ]
    }
  },
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "entity_type": { "const": "ticket_builder_result" },
    "status": { "type": "string", "enum": ["SUCCESS", "FAILURE"] },
    "primary_attempt_id": { "$ref": "#/$defs/stableId" },
    "selected_attempt_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/attempt" },
      "minItems": 1,
      "maxItems": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUCCESS" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "selected_attempt_id": { "$ref": "#/$defs/stableId" }
        }
      },
      "else": {
        "properties": {
          "selected_attempt_id": { "const": null }
        }
      }
    }
  ],
  "required": ["id", "entity_type", "status", "primary_attempt_id", "selected_attempt_id", "attempts"]
}
