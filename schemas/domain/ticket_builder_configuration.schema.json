{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ticket_builder_configuration.schema.json",
  "title": "Ticket Builder Configuration",
  "description": "A complete immutable constraint snapshot for one deterministic Builder attempt. Queue fingerprints and generation index are included because they affect reproducible selection.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "integer", "minimum": 0, "maximum": 99 },
        "maximum": { "type": "integer", "minimum": 0, "maximum": 99 }
      },
      "required": ["minimum", "maximum"]
    }
  },
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "entity_type": { "const": "ticket_builder_configuration" },
    "configuration_version": { "$ref": "#/$defs/stableId" },
    "scenario_or_mode_context": {
      "type": "string",
      "enum": ["CAMPAIGN", "MISSION", "CHALLENGE", "TRAINING", "COOPERATIVE", "COMPETITIVE", "SIMULATION"]
    },
    "requested_ticket_count": { "type": "integer", "minimum": 1, "maximum": 99 },
    "seed": { "type": "string", "minLength": 1 },
    "generator_version": { "$ref": "#/$defs/stableId" },
    "content_version": { "$ref": "#/$defs/stableId" },
    "domain_content_version": { "$ref": "#/$defs/stableId" },
    "card_catalog_version": { "$ref": "#/$defs/stableId" },
    "allowed_domain_ids": {
      "description": "When nonempty, a template's declared rule-significant domain footprint must be contained in this set.",
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "excluded_domain_ids": {
      "description": "A matching rule-significant domain reference excludes the complete template; exclusions win over allowances.",
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "allowed_tags": {
      "description": "When nonempty, a template must carry at least one allowed authored generation tag.",
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "excluded_tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "guaranteed_categories": {
      "description": "Every listed category must occur at least once across the complete selected batch.",
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "required_teaching_beats": {
      "description": "Every listed teaching beat must occur at least once across the complete selected batch.",
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "authored_difficulty_bounds": { "$ref": "#/$defs/bounds" },
    "fault_count_bounds": { "$ref": "#/$defs/bounds" },
    "required_actionable_fault_count_bounds": { "$ref": "#/$defs/bounds" },
    "causal_depth_bounds": { "$ref": "#/$defs/bounds" },
    "inbound_branching_bounds": { "$ref": "#/$defs/bounds" },
    "outbound_branching_bounds": { "$ref": "#/$defs/bounds" },
    "progressive_difficulty_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": { "$ref": "#/$defs/stableId" },
        "profile_version": { "$ref": "#/$defs/stableId" },
        "explicit_ceiling": { "type": "integer", "minimum": 1, "maximum": 10 },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start_generated_index": { "type": "integer", "minimum": 0 },
              "end_generated_index": { "type": "integer", "minimum": 0 },
              "target": { "type": "integer", "minimum": 1, "maximum": 10 },
              "minimum": { "type": "integer", "minimum": 1, "maximum": 10 },
              "maximum": { "type": "integer", "minimum": 1, "maximum": 10 }
            },
            "required": ["start_generated_index", "end_generated_index", "target", "minimum", "maximum"]
          }
        }
      },
      "required": ["profile_id", "profile_version", "explicit_ceiling", "bands"]
    },
    "generation_index_start": { "type": "integer", "minimum": 0 },
    "allow_duplicate_causal_fingerprints": { "type": "boolean" },
    "active_causal_fingerprints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "uniqueItems": true
    },
    "legal_card_definition_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true,
      "minItems": 1
    },
    "fallback_configuration_id": {
      "description": "Optional separately registered immutable fallback configuration. It is resolved and attempted only after a retained primary failure.",
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    }
  },
  "required": [
    "id",
    "entity_type",
    "configuration_version",
    "scenario_or_mode_context",
    "requested_ticket_count",
    "seed",
    "generator_version",
    "content_version",
    "domain_content_version",
    "card_catalog_version",
    "allowed_domain_ids",
    "excluded_domain_ids",
    "allowed_tags",
    "excluded_tags",
    "guaranteed_categories",
    "required_teaching_beats",
    "authored_difficulty_bounds",
    "fault_count_bounds",
    "required_actionable_fault_count_bounds",
    "causal_depth_bounds",
    "inbound_branching_bounds",
    "outbound_branching_bounds",
    "progressive_difficulty_profile",
    "generation_index_start",
    "allow_duplicate_causal_fingerprints",
    "active_causal_fingerprints",
    "legal_card_definition_ids",
    "fallback_configuration_id"
  ]
}
