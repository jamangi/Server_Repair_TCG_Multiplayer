{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical_copy_review.schema.json",
  "title": "Technical copy review ledger",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "stableIdArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    }
  },
  "properties": {
    "review_version": { "$ref": "#/$defs/stableId" },
    "reviewed_on": { "type": "string", "format": "date" },
    "review_scope": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "authority": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "title", "url", "authority"]
      }
    },
    "records": {
      "type": "array",
      "minItems": 71,
      "maxItems": 71,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain_id": { "$ref": "#/$defs/stableId" },
          "review_status": { "const": "reviewed" },
          "source_ids": { "$ref": "#/$defs/stableIdArray" },
          "acronym_ids": { "$ref": "#/$defs/stableIdArray" },
          "scoped_uncertainty": { "type": "string", "minLength": 1 },
          "technical_copy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["domain_id", "review_status", "source_ids", "acronym_ids", "scoped_uncertainty", "technical_copy_sha256"]
      }
    }
  },
  "required": ["review_version", "reviewed_on", "review_scope", "sources", "records"]
}
