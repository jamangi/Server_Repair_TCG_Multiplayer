{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/system_model_resolver_proof.schema.json",
  "title": "System Model Resolver Proof",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "status": { "enum": ["PASS", "FAIL"] }
        },
        "required": ["step", "code", "status"]
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalization_version": { "const": "canonical-json-v1" },
        "digest_algorithm": { "const": "sha256" },
        "content_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["canonicalization_version", "digest_algorithm", "content_digest"]
    }
  },
  "properties": {
    "schema_version": { "const": "system-model-resolver-proof-v1" },
    "proof_id": { "$ref": "#/$defs/stableId" },
    "architecture_decision": { "const": "SYSTEM-001-A" },
    "release_id": { "const": "system-model-pilot-v1" },
    "generator_version": { "const": "task-052-proof-generator-v1" },
    "input_digests": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" }
        },
        "required": ["input_id", "path", "sha256"]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": { "$ref": "#/$defs/stableId" },
          "ticket_id": { "$ref": "#/$defs/stableId" },
          "ticket_snapshot_digest": { "$ref": "#/$defs/digest" },
          "fingerprint_id": { "$ref": "#/$defs/stableId" },
          "binding_id": { "$ref": "#/$defs/stableId" },
          "resolver_key": { "$ref": "#/$defs/stableId" },
          "profile_id": { "$ref": "#/$defs/stableId" },
          "profile_revision": { "type": "integer", "minimum": 1 },
          "public_projection_path": { "type": "string", "pattern": "^docs/system-models/task-052/public-projections/.+\\.json$" },
          "public_projection_digest": { "$ref": "#/$defs/digest" },
          "semantic_model_digest": { "$ref": "#/$defs/digest" },
          "validation_trace": { "$ref": "#/$defs/trace" },
          "public_candidate_count": { "type": "integer", "minimum": 1 },
          "rationale_graph_count": { "type": "integer", "minimum": 1 },
          "differential_cases": { "type": "integer", "minimum": 1 },
          "public_candidate_combinations": { "type": "integer", "minimum": 1 },
          "source_review": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": { "$ref": "#/$defs/stableId" },
                "title": { "type": "string", "minLength": 1 },
                "publisher": { "type": "string", "minLength": 1 },
                "product_scope": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "minLength": 1 },
                "access_status": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https://" },
                "used_claim_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
              },
              "required": ["source_id", "title", "publisher", "product_scope", "revision", "access_status", "url", "used_claim_ids"]
            }
          },
          "authoring_validation_summary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": { "const": "PASS" },
              "reason_code": { "const": "AUTHORING_COMPATIBILITY_CONFIRMED" },
              "validation_trace": { "$ref": "#/$defs/trace" },
              "coverage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "authored_role_checks": { "type": "integer", "minimum": 1 },
                  "authored_action_checks": { "type": "integer", "minimum": 1 },
                  "differential_cases": { "type": "integer", "minimum": 1 }
                },
                "required": ["authored_role_checks", "authored_action_checks", "differential_cases"]
              },
              "public_projection_digest": { "$ref": "#/$defs/digest" },
              "gameplay_effect": { "const": "NONE" }
            },
            "required": ["status", "reason_code", "validation_trace", "coverage", "public_projection_digest", "gameplay_effect"]
          }
        },
        "required": ["case_id", "ticket_id", "ticket_snapshot_digest", "fingerprint_id", "binding_id", "resolver_key", "profile_id", "profile_revision", "public_projection_path", "public_projection_digest", "semantic_model_digest", "validation_trace", "public_candidate_count", "rationale_graph_count", "differential_cases", "public_candidate_combinations", "source_review", "authoring_validation_summary"]
      }
    },
    "invalid_profile_results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fixture_id": { "$ref": "#/$defs/stableId" },
          "title": { "type": "string", "minLength": 1 },
          "expected_reason_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "reason_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "materialized_profile_digest": { "$ref": "#/$defs/digest" },
          "validation_trace": { "$ref": "#/$defs/trace" },
          "fallback_id": { "$ref": "#/$defs/stableId" },
          "public_message": { "type": "string", "minLength": 1 },
          "gameplay_effect": { "const": "NONE" }
        },
        "required": ["fixture_id", "title", "expected_reason_code", "reason_code", "materialized_profile_digest", "validation_trace", "fallback_id", "public_message", "gameplay_effect"]
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolved_tickets": { "const": 5 },
        "unique_profiles": { "const": 2 },
        "public_projections": { "const": 5 },
        "invalid_profiles_rejected": { "const": 5 },
        "differential_cases": { "type": "integer", "minimum": 5 },
        "public_candidate_combinations": { "type": "integer", "minimum": 5 },
        "unique_rationale_attachments": { "const": 51 },
        "rendered_rationale_graphs": { "type": "integer", "minimum": 51 }
      },
      "required": ["resolved_tickets", "unique_profiles", "public_projections", "invalid_profiles_rejected", "differential_cases", "public_candidate_combinations", "unique_rationale_attachments", "rendered_rationale_graphs"]
    },
    "invariants": { "type": "array", "minItems": 8, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true },
    "deterministic_performance_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_profiles_scanned_per_resolution": { "type": "integer", "minimum": 1 },
        "maximum_bindings_scanned_per_resolution": { "type": "integer", "minimum": 1 },
        "network_requests_per_resolution": { "const": 0 },
        "random_choices_per_resolution": { "const": 0 },
        "fallback_profile_choices": { "const": 0 }
      },
      "required": ["maximum_profiles_scanned_per_resolution", "maximum_bindings_scanned_per_resolution", "network_requests_per_resolution", "random_choices_per_resolution", "fallback_profile_choices"]
    },
    "serialization": { "$ref": "#/$defs/serialization" }
  },
  "required": ["schema_version", "proof_id", "architecture_decision", "release_id", "generator_version", "input_digests", "cases", "invalid_profile_results", "totals", "invariants", "deterministic_performance_budget", "serialization"]
}
