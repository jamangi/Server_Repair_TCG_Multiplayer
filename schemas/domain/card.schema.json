{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/card.schema.json",
  "title": "Card Definition",
  "description": "An immutable authored gameplay definition. Human-readable rules text is presentation; play_contract is the executable contract.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "entityRef": {
      "$ref": "#/$defs/stableId"
    },
    "domainEntityType": {
      "type": "string",
      "enum": [
        "command",
        "component",
        "fault",
        "fault_causal_edge",
        "protocol",
        "repair_procedure",
        "symptom",
        "test",
        "tool",
        "validation_procedure"
      ]
    },
    "referenceRole": {
      "type": "string",
      "enum": [
        "execution",
        "subject",
        "requirement",
        "reference"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string"
        },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "alt_text": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string"
            },
            "crop_hint": {
              "type": "string"
            },
            "license_note": {
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "alt_text"
          ]
        }
      },
      "required": [
        "display_name"
      ]
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expansion_id": {
          "$ref": "#/$defs/entityRef"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "published",
            "deprecated"
          ]
        },
        "search_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "expansion_id",
        "version",
        "status"
      ]
    },
    "primaryDomainReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entityRef"
        },
        "entity_type": {
          "$ref": "#/$defs/domainEntityType"
        },
        "role": {
          "$ref": "#/$defs/referenceRole"
        },
        "inherit_illustration": {
          "type": "boolean"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "role",
        "inherit_illustration"
      ]
    },
    "additionalDomainReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entityRef"
        },
        "entity_type": {
          "$ref": "#/$defs/domainEntityType"
        },
        "role": {
          "$ref": "#/$defs/referenceRole"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "role"
      ]
    },
    "diagnosticTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": [
            "ACTIVE_TICKET",
            "TICKET_COMPONENT"
          ]
        },
        "allowed_component_definition_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityRef"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "target_kind",
        "allowed_component_definition_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "ACTIVE_TICKET"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_component_definition_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "TICKET_COMPONENT"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_component_definition_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "diagnosticContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "DIAGNOSTIC"
        },
        "action_type": {
          "const": "RUN_TEST"
        },
        "source_definition_id": {
          "$ref": "#/$defs/entityRef"
        },
        "source_entity_type": {
          "type": "string",
          "enum": [
            "test",
            "command"
          ]
        },
        "target_spec": {
          "$ref": "#/$defs/diagnosticTarget"
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 0
        },
        "resolution": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resolution_type": {
                "const": "AUTHORED_EVIDENCE"
              },
              "source_definition_id": {
                "$ref": "#/$defs/entityRef"
              }
            },
            "required": [
              "resolution_type",
              "source_definition_id"
            ]
          }
        },
        "disposition": {
          "enum": ["discard", "remain_in_diagnostic_bench"]
        },
        "placement": {
          "const": "diagnostic_bench"
        }
      },
      "required": [
        "contract_type",
        "action_type",
        "source_definition_id",
        "source_entity_type",
        "target_spec",
        "prerequisites",
        "resolution",
        "disposition"
      ]
    },
    "repairContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "REPAIR"
        },
        "action_type": {
          "const": "PERFORM_REPAIR"
        },
        "repair_procedure_id": {
          "$ref": "#/$defs/entityRef"
        },
        "target_spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_kind": {
              "const": "ACCEPTED_ISOLATED_FAULT"
            },
            "allowed_fault_definition_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entityRef"
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "required": [
            "target_kind",
            "allowed_fault_definition_ids"
          ]
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prerequisite_type": {
                "const": "ACCEPTED_ISOLATION"
              }
            },
            "required": [
              "prerequisite_type"
            ]
          }
        },
        "resolution": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resolution_type": {
                "const": "AUTHORED_REPAIR"
              },
              "repair_procedure_id": {
                "$ref": "#/$defs/entityRef"
              }
            },
            "required": [
              "resolution_type",
              "repair_procedure_id"
            ]
          }
        },
        "disposition": {
          "const": "discard"
        }
      },
      "required": [
        "contract_type",
        "action_type",
        "repair_procedure_id",
        "target_spec",
        "prerequisites",
        "resolution",
        "disposition"
      ]
    },
    "verifyContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "VERIFY"
        },
        "action_type": {
          "const": "PERFORM_VERIFY"
        },
        "validation_procedure_id": {
          "$ref": "#/$defs/entityRef"
        },
        "target_spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_kind": {
              "const": "ACTIVE_TICKET_VERIFICATION_REQUIREMENT"
            }
          },
          "required": [
            "target_kind"
          ]
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prerequisite_type": {
                "const": "REPAIR_HISTORY_PRESENT"
              }
            },
            "required": [
              "prerequisite_type"
            ]
          }
        },
        "resolution": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resolution_type": {
                "const": "AUTHORED_VERIFY"
              },
              "validation_procedure_id": {
                "$ref": "#/$defs/entityRef"
              }
            },
            "required": [
              "resolution_type",
              "validation_procedure_id"
            ]
          }
        },
        "disposition": {
          "const": "discard"
        }
      },
      "required": [
        "contract_type",
        "action_type",
        "validation_procedure_id",
        "target_spec",
        "prerequisites",
        "resolution",
        "disposition"
      ]
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "entity_type": {
      "const": "card"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "source": {
      "$ref": "#/$defs/sourceMeta"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "test",
        "command",
        "repair_procedure",
        "verification"
      ]
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rules_text": {
      "type": "string",
      "minLength": 1
    },
    "primary_domain_reference": {
      "$ref": "#/$defs/primaryDomainReference"
    },
    "additional_domain_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/additionalDomainReference"
      },
      "uniqueItems": true
    },
    "play_contract": {
      "oneOf": [
        {
          "$ref": "#/$defs/diagnosticContract"
        },
        {
          "$ref": "#/$defs/repairContract"
        },
        {
          "$ref": "#/$defs/verifyContract"
        }
      ]
    },
    "educational_text": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "entity_type",
    "presentation",
    "source",
    "card_type",
    "archetypes",
    "cost",
    "tags",
    "rules_text",
    "primary_domain_reference",
    "additional_domain_references",
    "play_contract"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "card_type": {
            "enum": [
              "test",
              "command"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "play_contract": {
            "$ref": "#/$defs/diagnosticContract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "card_type": {
            "const": "repair_procedure"
          }
        }
      },
      "then": {
        "properties": {
          "play_contract": {
            "$ref": "#/$defs/repairContract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "card_type": {
            "const": "verification"
          }
        }
      },
      "then": {
        "properties": {
          "play_contract": {
            "$ref": "#/$defs/verifyContract"
          }
        }
      }
    }
  ]
}
