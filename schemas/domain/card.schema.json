{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/card.schema.json",
  "title": "Card Definition",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string"
        },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "alt_text": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "crop_hint": {
              "type": "string"
            },
            "license_note": {
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "alt_text"
          ]
        }
      },
      "required": [
        "display_name"
      ]
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expansion_id": {
          "$ref": "#/$defs/entityRef"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "published",
            "deprecated"
          ]
        },
        "search_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "expansion_id",
        "status"
      ]
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "entity_type": {
      "const": "card"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "source": {
      "$ref": "#/$defs/sourceMeta"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "component",
        "tool",
        "test",
        "command",
        "repair_procedure",
        "verification",
        "workflow",
        "protocol",
        "event",
        "technician",
        "fault_reference",
        "repair_ticket"
      ]
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cost": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rules_text": {
      "type": "string"
    },
    "reference_entity_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effect_type": {
            "type": "string",
            "enum": [
              "draw",
              "search",
              "reveal",
              "add_evidence",
              "add_diagnosis",
              "repair_fault",
              "verify",
              "reduce_cost",
              "gain_action",
              "recover_card",
              "inspect_component",
              "move_ticket",
              "claim_ticket",
              "modify_test",
              "prevent_effect"
            ]
          },
          "target": {
            "type": "string"
          },
          "value": {
            "type": [
              "integer",
              "string",
              "boolean",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "effect_type"
        ]
      }
    },
    "educational_text": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "entity_type",
    "presentation",
    "source",
    "card_type",
    "archetypes",
    "cost",
    "rules_text",
    "reference_entity_ids",
    "effects"
  ]
}
