            "COOLS",
            "EXHAUSTS_THROUGH",
            "DATA_LINK_TO",
            "CONTROL_LINK_TO",
            "MANAGES",
            "BOOT_SOURCE_FOR",
            "HANDOFF_TO",
            "ENABLES",
            "OBSERVES",
            "REPORTS_INVENTORY_FOR",
            "EMITS_STATUS_AT",
            "MEASURES_PATH",
            "MEMBER_OF",
            "REDUNDANCY_PEER_OF",
