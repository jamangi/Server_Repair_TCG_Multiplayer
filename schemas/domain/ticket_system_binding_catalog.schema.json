{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ticket_system_binding_catalog.schema.json",
  "title": "Ticket System Binding Catalog",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": { "$ref": "system_model_catalog.schema.json#/$defs/stableId" },
    "digest": { "$ref": "system_model_catalog.schema.json#/$defs/digest" },
    "idArray": { "$ref": "system_model_catalog.schema.json#/$defs/idArray" },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": { "$ref": "#/$defs/stableId" },
        "profile_revision": { "type": "integer", "minimum": 1 },
        "profile_content_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["profile_id", "profile_revision", "profile_content_digest"]
    },
    "candidateClosure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_fault_id": { "type": "string", "pattern": "^fault\\." },
        "public_node_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "public_path_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "explanation": { "type": "string", "minLength": 1 }
      },
      "required": ["candidate_fault_id", "public_node_ids", "public_path_ids", "explanation"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_id": { "$ref": "#/$defs/stableId" },
        "public_resolver_key": { "$ref": "#/$defs/stableId" },
        "ticket_id": { "type": "string", "pattern": "^ticket\\." },
        "fingerprint_id": { "type": "string", "pattern": "^fingerprint\\." },
        "ticket_snapshot_digest": { "$ref": "#/$defs/digest" },
        "public_surface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "public_symptom_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^symptom\\." }, "uniqueItems": true },
            "public_candidate_fault_ids": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "pattern": "^fault\\." }, "uniqueItems": true },
            "public_surface_digest": { "$ref": "#/$defs/digest" }
          },
          "required": ["public_symptom_ids", "public_candidate_fault_ids", "public_surface_digest"]
        },
        "profile_ref": { "$ref": "#/$defs/profileRef" },
        "public_requirement_capability_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "candidate_closure": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/candidateClosure" } },
        "ticket_focus_statement": { "type": "string", "minLength": 1 },
        "fallback_id": { "$ref": "#/$defs/stableId" },
        "authority_boundary": { "const": "EXPLANATORY_ONLY" },
        "serialization": { "$ref": "system_model_catalog.schema.json#/$defs/serialization" }
      },
      "required": ["binding_id", "public_resolver_key", "ticket_id", "fingerprint_id", "ticket_snapshot_digest", "public_surface", "profile_ref", "public_requirement_capability_ids", "candidate_closure", "ticket_focus_statement", "fallback_id", "authority_boundary", "serialization"]
    }
  },
  "properties": {
    "schema_version": { "const": "ticket-system-binding-catalog-v1" },
    "release_id": { "const": "system-model-pilot-v1" },
    "contract_version": { "const": "system-model-contract-v1" },
    "canonicalization_version": { "const": "canonical-json-v1" },
    "bindings": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/binding" } },
    "serialization": { "$ref": "system_model_catalog.schema.json#/$defs/serialization" }
  },
  "required": ["schema_version", "release_id", "contract_version", "canonicalization_version", "bindings", "serialization"]
}
