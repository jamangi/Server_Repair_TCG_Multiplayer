      "type": "array"
    },
    "release_id": {
      "const": "system-model-story-v1"
    },
    "schema_files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
