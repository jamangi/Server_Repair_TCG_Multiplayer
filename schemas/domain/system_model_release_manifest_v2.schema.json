        "private_compatibility_proofs": {
          "const": 18
        },
        "profiles": {
          "const": 3
        },
        "relationship_findings": {
          "const": 125
        },
        "reused_profiles": {
          "const": 2
        },
        "ticket_bindings": {
          "const": 18
        },
        "ticket_instances": {
          "const": 18
        },
        "unique_fingerprints": {
          "const": 18
        }
      },
      "required": [
        "profiles",
        "reused_profiles",
        "new_profile_variants",
        "ticket_bindings",
        "private_compatibility_proofs",
        "relationship_findings",
        "added_components",
        "ticket_instances",
        "unique_fingerprints"
